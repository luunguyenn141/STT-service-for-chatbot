# ==============================================================================
# MSB Vietnamese Speech-to-Text Microservice Configuration
# ==============================================================================

# --- Microservice Security & Authentication ---
# Service-to-service API key for chatbot backend / mobile app gateway.
# Clients authenticate via header: `Authorization: Bearer <key>` or `x-api-key: <key>`.
# Leave empty for open development mode; set in staging and production.
SERVICE_API_KEY=

# Streaming PhoWhisper: one utterance per WebSocket, interim and final text.
# Tickets use SERVICE_API_KEY for signing. With multiple workers and no service
# key, configure the same STREAM_TOKEN_SECRET on every worker.
STREAM_TOKEN_SECRET=
STREAM_MAX_SESSIONS=2
STREAM_PARTIAL_SECONDS=1.0
STREAM_SILENCE_MS=900
STREAM_MAX_AUDIO_SECONDS=20
STREAM_VAD_THRESHOLD=0.012

# Rate limit: Maximum requests per minute per client IP (0 disables rate limiting)
RATE_LIMIT_PER_MINUTE=60

# Allowed CORS origins: Comma-separated list of origins for mobile webview / chatbot UI.
# Example: http://localhost:8000,http://localhost:3000,https://chatbot.bank.msb.com.vn
ALLOWED_ORIGINS=http://localhost:8000

# Maximum audio upload size in Megabytes (1 - 100)
MAX_UPLOAD_MB=25

# Upstream request timeout in seconds
REQUEST_TIMEOUT_SECONDS=60

# --- STT Provider Selection ---
# ElevenLabs Scribe v2 (Default: high-accuracy cloud STT with word timestamps & keyterms)
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
STT_MODEL_ID=scribe_v2
# Optional comma-separated banking domain terms to improve recognition accuracy for ElevenLabs
# Example: MSB, thẻ tín dụng, chuyển khoản, số dư, tiết kiệm, sao kê
STT_KEYTERMS=MSB, thẻ tín dụng, chuyển khoản, số dư, tài khoản, tiết kiệm

# --- Optional OpenAI transcript refinement ---
# The final transcript waits for this step. On timeout/error, the service returns
# a locally safe fallback and never drops the recognized text.
OPENAI_API_KEY=
OPENAI_REFINE_MODEL=gpt-4o-mini
STT_REFINE_ENABLED=true
STT_REFINE_TIMEOUT_SECONDS=8
STT_REFINE_MAX_CHARS=6000
# Convert explicit amounts such as "năm trăm nghìn" to "500.000 VND".
STT_REFINE_MONEY=true
STT_REFINE_MONEY_SEPARATOR=.
# title | upper | preserve. Lists/maps use JSON syntax in environment files.
STT_REFINE_NAME_CASE=title
STT_REFINE_NAMES=[]
STT_REFINE_TERM_ALIASES={"em ét bê":"MSB"}
STT_REFINE_ENTITIES=[]
STT_REFINE_MIN_SIMILARITY=0.72

# [Alternative: Local Inference via VinAI PhoWhisper]
# Install requirements-phowhisper.txt to use
PHOWHISPER_MODEL_ID=vinai/PhoWhisper-base
# Device: -1 for CPU, 0 for the first CUDA GPU device
PHOWHISPER_DEVICE=-1
# Load the model before the server reports ready (recommended in production)
PHOWHISPER_PRELOAD=false
