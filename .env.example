# Create a free ElevenLabs account, generate an API key, then copy this file to .env.
ELEVENLABS_API_KEY=
STT_PROVIDER=elevenlabs
STT_MODEL_ID=scribe_v2

# Optional comma-separated non-sensitive terms. Keyterms can incur a vendor charge.
STT_KEYTERMS=

MAX_UPLOAD_MB=25
REQUEST_TIMEOUT_SECONDS=60
ALLOWED_ORIGINS=http://localhost:8000
