# Public DNS name whose A record points to the GreenNode Floating IP.
DOMAIN=stt.example.com

# Used by Let's Encrypt for certificate-expiry notices.
ACME_EMAIL=ops@example.com

# Required service secret. Never commit the populated .env.production file.
SERVICE_API_KEY=replace_with_a_random_64_character_token

# Local Vietnamese STT on the GreenNode NVIDIA GPU. No audio is sent to an
# external transcription API. PhoWhisper does not support keyterm prompting.
STT_PROVIDER=phowhisper
PHOWHISPER_MODEL_ID=vinai/PhoWhisper-base
PHOWHISPER_DEVICE=0
PHOWHISPER_PRELOAD=true

RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=25
REQUEST_TIMEOUT_SECONDS=60
